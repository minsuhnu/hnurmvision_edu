<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_shm</transport_id>
      <type>SHM</type>
      <!-- A 1440x1080 BGR image is 4.67 MB; the 512 KB default is too small. -->
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>discovery_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="local_camera" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>camera_shm</transport_id>
        <transport_id>discovery_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
